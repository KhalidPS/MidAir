<?xml version="1.0" encoding="utf-8"?>
<!-- MidAir launcher foreground ("The Lift"): a file card floating above a glowing ring.
     Drawn on a 108 grid and scaled into the 66dp safe zone so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <!-- Ring glow, then the ring itself (iridescent: yellow, cyan, blue, magenta, pink). -->
        <path
            android:pathData="M24,81A30,8 0,1 1,84 81A30,8 0,1 1,24 81Z"
            android:strokeWidth="7"
            android:strokeAlpha="0.3">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="24" android:startY="81" android:endX="84" android:endY="81">
                    <item android:offset="0" android:color="#FFFFE15A" />
                    <item android:offset="0.25" android:color="#FF3FE0D0" />
                    <item android:offset="0.5" android:color="#FF2F7BFF" />
                    <item android:offset="0.75" android:color="#FFB53DFF" />
                    <item android:offset="1" android:color="#FFFF2E93" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M24,81A30,8 0,1 1,84 81A30,8 0,1 1,24 81Z"
            android:strokeWidth="3">
            <aapt:attr name="android:strokeColor">
                <gradient android:type="linear" android:startX="24" android:startY="81" android:endX="84" android:endY="81">
                    <item android:offset="0" android:color="#FFFFE15A" />
                    <item android:offset="0.25" android:color="#FF3FE0D0" />
                    <item android:offset="0.5" android:color="#FF2F7BFF" />
                    <item android:offset="0.75" android:color="#FFB53DFF" />
                    <item android:offset="1" android:color="#FFFF2E93" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Soft shadow the card casts on the ring. -->
        <path android:pathData="M39,81A15,3.5 0,1 1,69 81A15,3.5 0,1 1,39 81Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="radial" android:centerX="54" android:centerY="81" android:gradientRadius="15">
                    <item android:offset="0" android:color="#99000000" />
                    <item android:offset="1" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- The card, tilted as if just lifted, with an iridescent rim and four lines of text. -->
        <group
            android:pivotX="54"
            android:pivotY="42"
            android:rotation="8">
            <path
                android:fillColor="#FFEDEDF1"
                android:pathData="M44,20H64A7,7 0,0 1,71 27V57A7,7 0,0 1,64 64H44A7,7 0,0 1,37 57V27A7,7 0,0 1,44 20Z"
                android:strokeWidth="1.6">
                <aapt:attr name="android:strokeColor">
                    <gradient android:type="linear" android:startX="37" android:startY="20" android:endX="71" android:endY="64">
                        <item android:offset="0" android:color="#FFFFE15A" />
                        <item android:offset="0.5" android:color="#FF3FE0D0" />
                        <item android:offset="1" android:color="#FFFF2E93" />
                    </gradient>
                </aapt:attr>
            </path>
            <path
                android:fillColor="#FFD3D3DB"
                android:pathData="M44.5,28H63.5A1.5,1.5 0,0 1,63.5 31H44.5A1.5,1.5 0,0 1,44.5 28Z M44.5,34.5H56.5A1.5,1.5 0,0 1,56.5 37.5H44.5A1.5,1.5 0,0 1,44.5 34.5Z M44.5,41H60.5A1.5,1.5 0,0 1,60.5 44H44.5A1.5,1.5 0,0 1,44.5 41Z M44.5,47.5H53.5A1.5,1.5 0,0 1,53.5 50.5H44.5A1.5,1.5 0,0 1,44.5 47.5Z" />
        </group>
    </group>
</vector>
