<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a second launcher entry for the Twin Simulator. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".SimulatorActivity"
            android:exported="true"
            android:label="Air Twin Simulator"
            android:taskAffinity=".simulator"
            android:theme="@style/Theme.TransferingFileByAir">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
