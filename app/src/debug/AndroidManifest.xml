<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: the Twin Simulator, a developer tool that fakes two phones on one screen to tune the slide.
    It has no launcher icon, so the only icon is the real app. Open it with:
    adb shell am start -n com.kotlistine.transferingfilebyair/.SimulatorActivity
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".SimulatorActivity"
            android:exported="true"
            android:label="Air Twin Simulator (dev tool)"
            android:taskAffinity=".simulator"
            android:theme="@style/Theme.TransferingFileByAir" />
    </application>

</manifest>
